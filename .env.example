# このファイルを .env にコピーして使います。.env はgit管理外です。

# --- Google Sheets ---
# 情報源マスターのスプレッドシートID(URLの /d/ と /edit の間)
SOURCE_SHEET_ID=
# 記事データベースのスプレッドシートID
ARTICLE_SHEET_ID=
# シート(タブ)名。空欄なら先頭のシートを使います
SOURCE_WORKSHEET=
ARTICLE_WORKSHEET=

# --- Google OAuth ---
# Cloud ConsoleからダウンロードしたOAuthクライアントのJSON
GOOGLE_OAUTH_CLIENT_FILE=credentials/oauth_client.json
# 初回ログイン後に自動生成されるトークン
GOOGLE_TOKEN_FILE=credentials/token.json

# --- 収集設定 ---
# 1情報源あたり1回の実行で取得する最大件数
MAX_ARTICLES_PER_SOURCE=30
# RSS判定で、情報源ページからリンクされた同一サイトのページを調べる最大数
RSS_CRAWL_MAX_PAGES=100
# WEB判定で「記事一覧」とみなすのに必要な日付付きリンクの最小数
WEB_MIN_ARTICLE_LINKS=3
# WEB取得の新規記事について、記事ページのmeta descriptionをsummaryに入れるか
WEB_FETCH_META_DESCRIPTION=true

# --- HTTP ---
HTTP_TIMEOUT=15
HTTP_RETRIES=2
# 同じホストへの連続リクエストの間隔(秒)
REQUEST_INTERVAL=1.0
USER_AGENT=SpaceMediaCollector/1.0 (+student space media; contact: set-your-email)
